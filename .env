# 复制为 .env 后填写（.env 不会被 git 跟踪也可以，注意别提交密钥）

# 对话大模型（OpenAI 兼容协议）
OPENAI_API_KEY="填你自己的"
OPENAI_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat

# 向量模型：如果用 DeepSeek 等不提供 embedding 的服务，这里单独指向别家
# （例如 https://api.siliconflow.cn/v1 + BAAI/bge-m3，注意同时改 EMBEDDING_DIM）
EMBEDDING_API_KEY="填你自己的"
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# 向量库：milvus（本地 Milvus standalone）或 redis（Redis Stack）
VECTOR_STORE=milvus

# Milvus
MILVUS_ADDR=localhost:19530
MILVUS_COLLECTION=kb_chunks

# Redis Stack（VECTOR_STORE=redis 时才用到）
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_INDEX=kb_index
REDIS_KEY_PREFIX=eino_doc:

# 每次检索返回的片段数
TOPK=5

LOCAL_SCORE_THRESHOLD=0.85
