# ============ 国内直连推荐组合（DeepSeek 对话 + 硅基流动 embedding）============
# 对话：https://platform.deepseek.com/api_keys 领取
OPENAI_API_KEY=sk-这里填DeepSeek的Key
OPENAI_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat

# 向量：https://cloud.siliconflow.cn/account/ak 领取
# DeepSeek 不提供 embedding 接口，所以向量必须单独配一家
EMBEDDING_API_KEY=sk-这里填硅基流动的Key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# 是否把 EMBEDDING_DIM 下发给 embedding 接口（默认 false）
# OpenAI text-embedding-3 系列支持自定义维度，想压缩维度时设为 true；
# 硅基流动 / 智谱等平台不支持该参数，设 true 会报 400，保持 false 即可。
EMBEDDING_SET_DIMENSIONS=false

# 备选 embedding: 智谱 https://open.bigmodel.cn (EMBEDDING_MODEL=embedding-3, EMBEDDING_DIM=2048)
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_MODEL=embedding-3
# EMBEDDING_DIM=2048

# ============ 向量库 ============
# VECTOR_STORE 可选：
#   milvus = 本地 Milvus standalone（默认，推荐）
#   redis  = Redis Stack / RediSearch
VECTOR_STORE=milvus

# Milvus（VECTOR_STORE=milvus 时使用）
MILVUS_ADDR=localhost:19530
MILVUS_COLLECTION=kb_chunks
# 有鉴权时填写
# MILVUS_USERNAME=
# MILVUS_PASSWORD=

# Redis（VECTOR_STORE=redis 时使用）
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_INDEX=kb_index
REDIS_KEY_PREFIX=eino_doc:

# 每次检索返回的片段数
TOPK=5

# ============ 联网检索（本地笔记检索不到时的兜底）============
# SEARCH_PROVIDER 可选值：
#   none   = 关闭（默认）。库里没有时只能用模型自身知识回答，前端会明确标注
#   tavily = https://tavily.com 领取 Key（api.tavily.com）
#   bocha  = https://open.bochaai.com 博查 AI，国内可直连
SEARCH_PROVIDER=none
SEARCH_API_KEY=
SEARCH_TOPK=5

# 本地命中的相似度阈值：检索最高分 >= 该值直接判定「笔记里有」。
# bge-m3 的中文分数区分度不高（相关的 0.68、不相关的也可能 0.73），
# 所以只有极高分会直接命中，其余都交给模型复核片段能否真正回答。
LOCAL_SCORE_THRESHOLD=0.85

# 联网答案的沉淀方式：
#   direct = 直接写入对应的知识库（由模型挑库，实在没有合适的就新建）
#   inbox  = 先写到 notes/待确认/ 体系，人工确认后再转正（推荐谨慎用这个）
WEB_SAVE_MODE=direct

# 注意：换 EMBEDDING_MODEL 时 EMBEDDING_DIM 必须跟着改，
# 且要用 go run ./cmd/index -dir ./notes -reset 重建索引（否则维度不匹配）
